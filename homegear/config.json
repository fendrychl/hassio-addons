{
  "name": "Homegear",
  "version": "0.73.1",
  "slug": "homegear",
  "description": "Homegear as a Hassio add-on",
  "arch": [
    "aarch64",
    "amd64",
    "armv7"
  ],
  "startup": "services",
  "boot": "auto",
  "timeout": 30,
  "webui": "http://[HOST]:[PORT:2001]/admin/",
  "uart": true,
  "gpio": true,
  "privileged": [
    "SYS_ADMIN",
    "SYS_RAWIO"
  ],
  "map": [
    "config:rw",
    "share:rw"
  ],
  "ports": {
    "2001": 2001,
    "2002": 2002,
    "2003": 2003
  },
  "ports_description": {
    "2001": "Web UI (/admin/) and RPC, no SSL, no authentication",
    "2002": "Deprecated! SSL enabled, authentication enabled",
    "2003": "Deprecated! SSL and authentication enabled"
  },
  "environment": {},
  "options": {},
  "schema": {}
}
